# Supplier stack for {{NETWORK}}, written by the Pocket Service Manager: one HA
# RelayMiner (redis + miner + relayer) serving every service this stack's supplier is
# staked for. A server holds one stack per network, each in its own directory with
# its own operator key; TLS is the server's shared Caddy (see the caddy directory),
# which reaches the relayer by container name on the shared "pocket-supplier"
# network. Service backends run from their own compose files under the deploy root
# and join that same network, so one backend container serves both networks.
# Redis and the miner stay on this stack's private network. Nothing here is exposed
# to the internet. The relayer starts once the first service is added (it refuses an
# empty list).
#
# Images and memory limits come from compose.env, which supplier.sh writes from
# stack.env (the versions the app pinned) and from this server's own memory and CPUs,
# so this file is always run as `docker compose --env-file compose.env`. Redis must be
# 8.10 or newer with maxmemory and noeviction: the RelayMiner refuses anything else,
# because an evicted key is a claim that cannot be proved. The miner starts first; the
# relayer is not ready until the miner has published its service manifest.

name: {{PROJECT}}

services:
  redis:
    image: ${REDIS_IMAGE}
    container_name: {{PROJECT}}-redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory ${REDIS_MAXMEMORY} --maxmemory-policy noeviction --io-threads 1
    mem_limit: ${REDIS_MEM_LIMIT}
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    networks: [internal]

  miner:
    image: ${RELAYMINER_IMAGE}
    container_name: {{PROJECT}}-miner
    restart: unless-stopped
    command: ["miner", "--config", "/config/config.yaml"]
    volumes:
      - ./miner-config.yaml:/config/config.yaml:ro
      - ./supplier-keys.yaml:/keys/supplier-keys.yaml:ro
    ports:
      - "127.0.0.1:{{MINER_METRICS_PORT}}:9092"
    mem_limit: ${MINER_MEM_LIMIT}
    environment:
      GOMEMLIMIT: ${MINER_GOMEMLIMIT}
      GOMAXPROCS: "${GOMAXPROCS}"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:9092/health"]
      interval: 5s
      timeout: 3s
      retries: 30
    depends_on:
      redis: { condition: service_healthy }
    networks: [internal]

  relayer:
    image: ${RELAYMINER_IMAGE}
    container_name: {{PROJECT}}-relayer
    restart: unless-stopped
    command: ["relayer", "--config", "/config/config.yaml"]
    volumes:
      - ./relayer-config.yaml:/config/config.yaml:ro
      - ./supplier-keys.yaml:/keys/supplier-keys.yaml:ro
    expose:
      - "8080"
    ports:
      - "127.0.0.1:{{HEALTH_PORT}}:8081"
      - "127.0.0.1:{{RELAYER_METRICS_PORT}}:9090"
    mem_limit: ${RELAYER_MEM_LIMIT}
    environment:
      GOMEMLIMIT: ${RELAYER_GOMEMLIMIT}
      GOMAXPROCS: "${GOMAXPROCS}"
    depends_on:
      redis: { condition: service_healthy }
      miner: { condition: service_healthy }
    networks: [internal, supplier]

networks:
  internal: {}
  supplier:
    name: pocket-supplier
    external: true

volumes:
  redis-data:
